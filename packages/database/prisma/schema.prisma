datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MEMBER
  VIEWER
}

enum OptimizationMode {
  SAFE
  BALANCED
  AGGRESSIVE
}

enum RoutingPolicy {
  DIRECT
  COST_OPTIMIZED
  PERFORMANCE_OPTIMIZED
  BALANCED
}

model User {
  id            String               @id @default(uuid())
  email         String               @unique
  name          String?
  passwordHash  String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  memberships   OrganizationMember[]
  auditLogs     AuditLog[]
}

model Organization {
  id          String               @id @default(uuid())
  name        String
  slug        String               @unique
  plan        String               @default("FREE")
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  members     OrganizationMember[]
  projects    Project[]
  credentials ProviderCredential[]
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  role           Role         @default(MEMBER)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model Project {
  id               String             @id @default(uuid())
  organizationId   String
  name             String
  slug             String
  optimizationMode OptimizationMode   @default(BALANCED)
  routingPolicy    RoutingPolicy      @default(DIRECT)
  cacheEnabled     Boolean            @default(true)
  cacheSimilarity  Float              @default(0.90)
  cacheTtlSeconds  Int                @default(86400)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  apiKeys          ApiKey[]
  requests         Request[]
  cacheEntries     CacheEntry[]
  conversations    Conversation[]
  documents        Document[]
  benchmarks       Benchmark[]
  usageDaily       UsageDaily[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model ApiKey {
  id         String    @id @default(uuid())
  projectId  String
  name       String
  keyHash    String    @unique
  keyPrefix  String
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Provider {
  id          String               @id @default(uuid())
  name        String               @unique
  displayName String
  baseUrl     String?
  models      Model[]
  credentials ProviderCredential[]
}

model ProviderCredential {
  id             String       @id @default(uuid())
  organizationId String
  providerId     String
  encryptedKey   String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider       Provider     @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Model {
  id              String         @id @default(uuid())
  providerId      String
  modelId         String
  displayName     String
  contextWindow   Int            @default(128000)
  inputCostPer1k  Float
  outputCostPer1k Float
  provider        Provider       @relation(fields: [providerId], references: [id], onDelete: Cascade)
  requests        Request[]
  modelPricings   ModelPricing[]

  @@unique([providerId, modelId])
}

model ModelPricing {
  id              String   @id @default(uuid())
  modelId         String
  effectiveDate   DateTime @default(now())
  inputCostPer1k  Float
  outputCostPer1k Float
  model           Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)
}

model Request {
  id                   String               @id @default(uuid())
  projectId            String
  modelId              String
  originalModel        String
  targetModel          String
  originalInputTokens  Int
  optimizedInputTokens Int
  tokensSaved          Int
  reductionPercentage  Float
  outputTokens         Int                  @default(0)
  estimatedCostBefore  Float
  estimatedCostAfter   Float
  estimatedCostSaved   Float
  latencyMs            Int
  cacheHit             Boolean              @default(false)
  cacheSimilarity      Float?
  optimizationMode     OptimizationMode
  createdAt            DateTime             @default(now())
  project              Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  model                Model                @relation(fields: [modelId], references: [id])
  requestMessages      RequestMessage[]
  optimizationResults  OptimizationResult[]

  @@index([projectId, createdAt])
  @@index([createdAt])
}

model RequestMessage {
  id        String   @id @default(uuid())
  requestId String
  role      String
  type      String   // ORIGINAL or OPTIMIZED
  content   String   @db.Text
  request   Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model OptimizationResult {
  id          String   @id @default(uuid())
  requestId   String
  technique   String
  description String
  tokensSaved Int
  details     Json?
  request     Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model TokenUsage {
  id          String   @id @default(uuid())
  projectId   String
  requestId   String
  inputTokens Int
  tokensSaved Int
  createdAt   DateTime @default(now())
}

model CacheEntry {
  id               String   @id @default(uuid())
  projectId        String
  promptHash       String
  systemHash       String
  promptText       String   @db.Text
  responseText     String   @db.Text
  modelId          String
  hitCount         Int      @default(0)
  tokensSavedTotal Int      @default(0)
  costSavedTotal   Float    @default(0)
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, promptHash])
}

model Conversation {
  id         String                @id @default(uuid())
  projectId  String
  externalId String?
  summary    String?               @db.Text
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  project    Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages   ConversationMessage[]
  memories   Memory[]

  @@index([projectId])
}

model ConversationMessage {
  id             String       @id @default(uuid())
  conversationId String
  role           String
  content        String       @db.Text
  tokenCount     Int
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Memory {
  id             String       @id @default(uuid())
  conversationId String
  key            String
  value          String       @db.Text
  importance     Float        @default(1.0)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Document {
  id        String          @id @default(uuid())
  projectId String
  title     String
  content   String          @db.Text
  createdAt DateTime        @default(now())
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chunks    DocumentChunk[]
}

model DocumentChunk {
  id         String   @id @default(uuid())
  documentId String
  chunkIndex Int
  content    String   @db.Text
  tokenCount Int
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model Embedding {
  id        String   @id @default(uuid())
  entityType String
  entityId  String
  vector    String   @db.Text
  createdAt DateTime @default(now())
}

model UsageDaily {
  id                   String   @id @default(uuid())
  projectId            String
  date                 DateTime @db.Date
  requestCount         Int      @default(0)
  originalTokensTotal  BigInt   @default(0)
  optimizedTokensTotal BigInt   @default(0)
  tokensSavedTotal     BigInt   @default(0)
  costBeforeTotal      Float    @default(0)
  costAfterTotal       Float    @default(0)
  costSavedTotal       Float    @default(0)
  cacheHitCount        Int      @default(0)
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, date])
}

model Benchmark {
  id          String            @id @default(uuid())
  projectId   String
  name        String
  description String?
  createdAt   DateTime          @default(now())
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  results     BenchmarkResult[]
}

model BenchmarkResult {
  id                  String    @id @default(uuid())
  benchmarkId         String
  originalPrompt      String    @db.Text
  optimizedPrompt     String    @db.Text
  originalTokens      Int
  optimizedTokens     Int
  tokensSaved         Int
  reductionPercentage Float
  qualityScore        Float     @default(1.0)
  latencyMs           Int
  benchmark           Benchmark @relation(fields: [benchmarkId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  target    String
  details   Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}
