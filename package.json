{
  "name": "promptx-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "PromptX - Intelligent LLM Token Optimization Platform & TokenForge Gateway",
  "author": "PromptX Team",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev": "npm --workspace=apps/api run dev",
    "dev:web": "npm --workspace=apps/web run dev",
    "dev:api": "npm --workspace=apps/api run dev",
    "prisma:generate": "npm --workspace=packages/database run generate",
    "prisma:push": "npm --workspace=packages/database run push",
    "prisma:seed": "npm --workspace=packages/database run seed"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "@types/node": "^20.11.0"
  },
  "devDependencies": {
    "typescript": "^5.2.2",
    "styled-jsx": "5.1.1",
    "postcss": "^8.4.31",
    "postcss-selector-parser": "^6.0.13",
    "postcss-nested": "^6.0.1",
    "postcss-js": "^4.0.1",
    "postcss-load-config": "^4.0.1",
    "postcss-value-parser": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "picomatch": "^2.3.1",
    "micromatch": "^4.0.5",
    "normalize-path": "^3.0.0",
    "didyoumean": "^1.2.2",
    "dlv": "^1.1.3",
    "fast-glob": "^3.3.2",
    "glob-parent": "^6.0.2",
    "is-glob": "^4.0.3",
    "object-hash": "^3.0.0",
    "picocolors": "^1.0.0",
    "queue-microtask": "^1.2.3",
    "reusify": "^1.0.4",
    "resolve": "^1.22.8",
    "ts-interface-checker": "^0.1.13",
    "sucrase": "^3.35.0",
    "watchpack": "^2.4.0"
  }
}
