# PromptX / TokenForge Production & Local Environment Configuration

# Server & Runtime Configuration
NODE_ENV=production
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Next.js Web App API Target (used by web frontend)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Database Configuration (PostgreSQL + pgvector)
DATABASE_URL="postgresql://promptx:promptx_password@localhost:5432/promptx_db?schema=public"

# Redis Configuration (Semantic Caching & Rate Limiting)
REDIS_URL="redis://localhost:6379"

# Security & Authentication Secrets
JWT_SECRET="promptx_production_jwt_secret_key_change_me_2026"

# LLM Provider API Keys (Optional - Fallback demo adapter enabled if left empty)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
